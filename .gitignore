# =========================
# 🧠 General
# =========================
# Logs and temp files
logs/
*.log
*.tmp
*.temp
npm-debug.log*
yarn-debug.log*
pnpm-debug.log*
lerna-debug.log*

# OS-specific files
.DS_Store
Thumbs.db

# =========================
# 🧪 Backend (Python)
# =========================
__pycache__/
*.py[cod]
*.pyo
*.so
*.egg
*.egg-info/
.eggs/
*.spec
.Python
env/
venv/
.venv/
ENV/
ENV*/
pip-log.txt
pip-delete-this-directory.txt
.env
*.env

# Ignore model checkpoints or weights but keep README placeholders
*.pt
*.pth
*.h5
*.ckpt
*.onnx


# Ignore static file outputs but keep README placeholders
backend/static/results/*
backend/static/uploads/*
!backend/static/results/README.md
!backend/static/uploads/README.md

# Ignore compiled bytecode or cache
backend/**/*.pyc

# Ignore database or local dev files
*.db
*.sqlite3

# =========================
# 🤖 Dev / Training
# =========================
# Dataset folder: ignore everything except README.md


# =========================
# ⚛️ Frontend (React)
# =========================
# Ignore node_modules everywhere
**/node_modules/

# Ignore build outputs and caches
frontend/dist/
frontend/build/
frontend/.vite/
frontend/.parcel-cache/
frontend/.next/
frontend/.cache/
frontend/npm-debug.log*
frontend/yarn-debug.log*
frontend/yarn-error.log*

# Environment files
frontend/.env
frontend/.env.local
frontend/.env.development.local
frontend/.env.test.local
frontend/.env.production.local

# =========================
# 🧑‍💻 Editor / IDE
# =========================
.vscode/*
!.vscode/extensions.json
.idea/
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?

# =========================
# 📦 Optional Package Manager Locks
# =========================
# If you only use npm, ignore others
# yarn.lock
# pnpm-lock.yaml

# =========================
# 🚫 Big Folders/Files
# =========================
# Ignore large folders and files to reduce repo size
backend/static/results/
backend/static/uploads/
dev/
!runs/detect/README.md
